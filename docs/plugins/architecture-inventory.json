  "invariants": [
    {
      "id": "INV-01",
      "rule": "No ambient filesystem/network/process/FFI grants to community guests",
      "firstGate": "PLUGIN-05"
    },
    {
      "id": "INV-02",
      "rule": "Identity is verified by host; grants are per installed plugin instance and per vault",
      "firstGate": "PLUGIN-02"
    },
    {
      "id": "INV-03",
      "rule": "All metadata, search and event payloads use content-read scopes",
      "firstGate": "PLUGIN-07"
    },
    {
      "id": "INV-04",
      "rule": "All guest writes are revision-guarded via DocumentHub and File Gate",
      "firstGate": "PLUGIN-09"
    },
    {
      "id": "INV-05",
      "rule": "Rendered Markdown/assets are checked for unintended network side effects",
      "firstGate": "PLUGIN-10"
    },
    {
      "id": "INV-06",
      "rule": "Guests do not bypass permission broker via MCP/IPC/clipboard",
      "firstGate": "PLUGIN-16"
    },
    {
      "id": "INV-07",
      "rule": "Built-in sync stays independent, no copied plugin code/grants auto activate",
      "firstGate": "PLUGIN-12"
    },
    {
      "id": "INV-08",
      "rule": "Local Markdown remains usable offline with plugins disabled",
      "firstGate": "PLUGIN-12"
    },
    {
      "id": "INV-09",
      "rule": "Updates cannot silently expand grants or swap publisher identity",
      "firstGate": "PLUGIN-19"
    },
    {
      "id": "INV-10",
      "rule": "Guest resource quotas and crashes cannot freeze native editor",
      "firstGate": "PLUGIN-06"
    }
  ],
  "trustZones": [
    "trusted-host",
    "trusted-ui",
    "trusted-entry",
